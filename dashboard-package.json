{
  "name": "lotto-generator-dashboard",
  "version": "1.0.0",
  "description": "Lotto Generator 프로젝트 실시간 분석 대시보드",
  "main": "dashboard-main.js",
  "scripts": {
    "start": "electron dashboard-main.js",
    "dev": "electron dashboard-main.js --dev",
    "dashboard": "electron dashboard-main.js",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [
    "dashboard",
    "analytics",
    "project-monitoring",
    "electron",
    "adsense"
  ],
  "author": "Project Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^latest"
  },
  "dependencies": {
    "chart.js": "^latest"
  },
  "build": {
    "appId": "com.lottogenerator.dashboard",
    "productName": "Lotto Generator Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dashboard.html",
      "dashboard-main.js",
      "site_logo.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
} 